APP_NAME="Izwi Web"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# HTTP-only for now — switch to https:// and flip SESSION_SECURE_COOKIE
# back to true below once SSL/AutoSSL is enabled for this subdomain.
APP_URL=http://teamvelvet.steinovate.com

NET_API_BASE_URL=https://izwi-api.steinovate.com
NET_API_TIMEOUT=30

# One-time-use secret for public/setup.php. Generate a fresh random value
# before each deploy, e.g.:
#   php -r "echo 'base64:'.base64_encode(random_bytes(24));"
# Never reuse a value that's already been used on a live deployment.
SETUP_SECRET=CHANGE-ME-GENERATE-A-NEW-RANDOM-VALUE

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# false because there's no HTTPS yet — a "secure" cookie is never sent by
# the browser over plain HTTP, which would silently break login. Flip to
# true once SSL is enabled (see APP_URL note above).
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
